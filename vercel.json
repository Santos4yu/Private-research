{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/prediction.py": {
      "maxDuration": 60
    },
    "api/v2-admin.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/v2-admin?action=cron-scan", "schedule": "0 * * * *" }
  ]
}
