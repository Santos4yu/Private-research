# Storage remains on the original provider until an approved cutover.
WEBSITE_STORAGE_BACKEND=upstash
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Existing Supabase account project. Server-only; never use VITE_ prefixes.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Preferred server secret; alternatively SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# Preserve existing deployment secrets and admin PIN; do not generate new ones
# as part of storage migration or invalidate existing accounts by changing them.

# Paid access through Whop (whop_billing.py). Server-only.
# Company API key: Whop dashboard -> Developer -> API keys.
WHOP_API_KEY=
# Signing secret of the webhook pointed at https://<your site>/api/whop/webhook
WHOP_WEBHOOK_SECRET=
# The plan_ ids to offer, comma separated, in the order to show them.
WHOP_PLAN_IDS=

# Site health alerts (site_health.py): a Discord channel webhook link to post
# problems to (Channel settings -> Integrations -> Webhooks -> Copy link).
ALERT_WEBHOOK_URL=
