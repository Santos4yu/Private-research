{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/auth/:action", "destination": "/api/session?action=:action" },
    { "source": "/api/nfl/:resource", "destination": "/api/nfl?resource=:resource" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/team-insights.py": {
      "maxDuration": 60
    },
    "api/board.py": {
      "maxDuration": 60,
      "includeFiles": "data/tennis/history.json.gz"
    },
    "api/nfl.py": {
      "maxDuration": 60
    },
    "api/wnba.py": {
      "maxDuration": 60
    },
    "api/prediction.py": {
      "maxDuration": 60
    },
    "api/v2-admin.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/v2-admin?action=finder-history-cron", "schedule": "30 9 * * *" },
    { "path": "/api/v2-admin?action=tennis-cron-scan", "schedule": "0 8 * * *" },
    { "path": "/api/v2-admin?action=cron-scan", "schedule": "0 10 * * *" },
    { "path": "/api/v2-admin?action=nfl-cron-scan", "schedule": "0 11 * * *" }
  ]
}
