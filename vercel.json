{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/auth/:action", "destination": "/api/session?action=:action" },
    { "source": "/api/whop/webhook", "destination": "/api/session?action=whop-webhook" },
    { "source": "/api/nfl/:resource", "destination": "/api/nfl?resource=:resource" },
    { "source": "/results", "destination": "/results.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/team-insights.py": {
      "maxDuration": 60
    },
    "api/board.py": {
      "maxDuration": 60,
      "includeFiles": "data/**"
    },
    "api/nfl.py": {
      "maxDuration": 60,
      "includeFiles": "data/nfl/**"
    },
    "api/wnba.py": {
      "maxDuration": 60
    },
    "api/prediction.py": {
      "maxDuration": 60
    },
    "api/v2-admin.py": {
      "maxDuration": 60,
      "includeFiles": "data/nfl/**"
    }
  },
  "crons": [
    { "path": "/api/v2-admin?action=finder-history-cron", "schedule": "30 9 * * *" },
    { "path": "/api/v2-admin?action=tennis-cron-scan", "schedule": "0 8 * * *" },
    { "path": "/api/v2-admin?action=cron-scan", "schedule": "0 10 * * *" },
    { "path": "/api/v2-admin?action=nfl-cron-scan", "schedule": "0 11 * * *" },
    { "path": "/api/v2-admin?action=nfl-plays-cron", "schedule": "0 12 * * *" },
    { "path": "/api/v2-admin?action=health-cron", "schedule": "0 13 * * *" },
    { "path": "/api/v2-admin?action=nba-depth-test", "schedule": "30 16 * * *" },
    { "path": "/api/v2-admin?action=predictor-cron&step=epa", "schedule": "30 12 * * *" },
    { "path": "/api/v2-admin?action=predictor-cron&step=epa-last", "schedule": "50 12 * * *" },
    { "path": "/api/v2-admin?action=predictor-cron&step=snapshot", "schedule": "40 16 * * *" },
    { "path": "/api/v2-admin?action=predictor-cron&step=snapshot&run=late", "schedule": "40 22 * * *" },
    { "path": "/api/v2-admin?action=predictor-cron&step=record", "schedule": "50 16 * * *" },
    { "path": "/api/v2-admin?action=predictor-cron&step=record&run=1750", "schedule": "50 17 * * *" },
    { "path": "/api/v2-admin?action=predictor-cron&step=record&run=1850", "schedule": "50 18 * * *" },
    { "path": "/api/v2-admin?action=predictor-cron&step=record&run=1950", "schedule": "50 19 * * *" },
    { "path": "/api/v2-admin?action=predictor-cron&step=record&run=2050", "schedule": "50 20 * * *" },
    { "path": "/api/v2-admin?action=predictor-cron&step=record&run=2150", "schedule": "50 21 * * *" },
    { "path": "/api/v2-admin?action=predictor-cron&step=record&run=late", "schedule": "50 22 * * *" },
    { "path": "/api/v2-admin?action=predictor-cron&step=record&run=2350", "schedule": "50 23 * * *" },
    { "path": "/api/v2-admin?action=predictor-cron&step=record&run=0050", "schedule": "50 0 * * *" },
    { "path": "/api/v2-admin?action=predictor-cron&step=record&run=0150", "schedule": "50 1 * * *" },
    { "path": "/api/v2-admin?action=predictor-cron&step=record&run=0250", "schedule": "50 2 * * *" }
  ]
}
